# Copy to .env and chmod 600. Never commit real tokens or phone numbers.

ADWAVE_BASE_URL=https://dash.adwave.guru/api/
ADWAVE_WORKSPACE_ID=69916ea2430b6f31d9cb0d8a

# Digits only, no plus. Used solely for the one-time WhatsApp OTP login.
ADWAVE_PHONE=

# Optional: tokens can live here OR in ADWAVE_TOKEN_FILE (preferred).
ADWAVE_ACCESS_TOKEN=
ADWAVE_REFRESH_TOKEN=
ADWAVE_TOKEN_FILE=.secrets/tokens.json

ADWAVE_OUTPUT_DIR=data
ADWAVE_LOG_DIR=logs
ADWAVE_FORMAT=both
ADWAVE_CHUNK_DAYS=3
ADWAVE_REQUEST_TIMEOUT=90
ADWAVE_MAX_RETRIES=4
ADWAVE_DEFAULT_DAYS=7

# Notify after N consecutive failed scheduled/sync runs (optional).
ADWAVE_NOTIFY_WEBHOOK=
ADWAVE_NOTIFY_AFTER_FAILURES=3
